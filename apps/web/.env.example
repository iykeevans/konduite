# Copy to .env.local. Values come from `supabase status` (local) or the
# project's API settings (hosted). The publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Go API base URL. Server-only: the web app calls the API from the server
# with the signed-in user's Supabase access token.
KONDUITE_API_URL=http://127.0.0.1:8080
