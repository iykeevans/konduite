# Copy to .env for local development. Never commit .env.
APP_ENV=development
API_ADDR=:8080
API_SHUTDOWN_TIMEOUT=15s
WORKER_DRAIN_TIMEOUT=30s
# Local Supabase database (`supabase start`)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Local Supabase project URL (`supabase status` shows it); the API verifies
# access tokens against its JWKS.
SUPABASE_URL=http://127.0.0.1:54321
# Local NATS JetStream (`make infra-up`)
NATS_URL=nats://127.0.0.1:4222
