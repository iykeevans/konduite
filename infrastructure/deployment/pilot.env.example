# Copy to infrastructure/deployment/.env (gitignored) and fill in on the pilot
# host. Placeholders only: never commit real values.

# Postgres from hosted Supabase. Use the direct or session-pooler connection
# (port 5432), not the transaction pooler: migrations need a session.
DATABASE_URL=postgresql://postgres:CHANGE_ME@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Hosted Supabase project URL; the API verifies access tokens against its JWKS.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Hosted NATS with JetStream enabled (tls:// or nats://, with credentials in
# the URL if the provider requires them).
NATS_URL=tls://CHANGE_ME@nats.example.com:4222

# Ed25519 seed that signs runtime access tokens. Generate: openssl rand -base64 32
# Rotating it invalidates every issued runtime token.
RUNTIME_TOKEN_SIGNING_KEY=

# Comma-separated Supabase user ids allowed on /api/v1/admin. Empty denies everyone.
PLATFORM_ADMIN_USER_IDS=

# Web: public values only, inlined into the browser bundle at build time.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=CHANGE_ME_PUBLISHABLE_KEY

# Optional host ports.
# API_PORT=8080
# WEB_PORT=3000
